# Copy this file to .env.local and fill in the values.
# On Vercel, add the same variables under Project Settings > Environment Variables.

# Required for the contact form. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: where contact form messages are delivered (defaults to the email in lib/site.ts)
CONTACT_TO_EMAIL=

# Optional: sender address. Leave empty to use Resend's test sender, which can only
# deliver to the email you signed up to Resend with. Set it after verifying a domain.
CONTACT_FROM_EMAIL=

# Optional overrides used across the site
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GITHUB_USERNAME=
